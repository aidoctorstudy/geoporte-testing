# Public site origin — no trailing slash.
# Drives canonical URLs, Open Graph / Twitter tags, robots.txt, sitemap.xml,
# and JSON-LD structured data. Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Server-only (no NEXT_PUBLIC_ prefix — never exposed to the browser) ---

# Optional upstream the /api/contact route forwards leads to (CRM / webhook).
# When unset, the route logs submissions server-side instead.
CONTACT_ENDPOINT=

# Password for the /admin content editor (simple single-password gate, not a
# real auth system). /admin refuses to log anyone in while this is unset.
ADMIN_PASSWORD=

# Lets /admin publish to production instead of just writing a local file
# (which doesn't work on Vercel's read-only filesystem — see
# obsidian/meta/decisions-log.md ADR-0113). All three required together; if
# any is missing, /admin falls back to the local-file write (dev only).
#
# GITHUB_TOKEN   — a fine-grained PAT scoped to this one repo, "Contents: write".
# GITHUB_REPO    — "owner/repo", e.g. aidoctorstudy/geoporte-testing.
# GITHUB_BRANCH  — optional, defaults to "master" (this repo's default branch).
# VERCEL_DEPLOY_HOOK — a Deploy Hook URL from the Vercel project's Git settings.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=
VERCEL_DEPLOY_HOOK=
